# Copy this file to `.env` (same folder) and fill it in. finlake reads it on
# import; a real environment variable with the same name takes precedence.
# `.env` is gitignored, so your credentials never leave this machine.

# REQUIRED. The SEC returns 403 without a real contact address, and IP-bans
# clients that ignore its rate limit. Use the form: finlake/0.13 (you@example.com)
SEC_USER_AGENT=

# Optional. Only needed for macro series (rates, inflation, GDP, the yield
# curve). Free from https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Optional. Where the cache lives. Defaults to ~/.finlake
# FINLAKE_HOME=

# Optional. Path to the full Loughran-McDonald master dictionary CSV. Without
# it, news sentiment uses the bundled subset of the word lists.
# FINLAKE_LM_DICTIONARY=
